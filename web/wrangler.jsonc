{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentris-web",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 3 * * *"] },
  "upload_source_maps": true,
  "assets": { "html_handling": "drop-trailing-slash" },
  "d1_databases": [
    { "binding": "DB", "database_name": "sentris", "database_id": "33fe442a-0da2-42d8-a811-78c7c880dda0", "migrations_dir": "drizzle" }
  ],
  "vars": {
    "APP_URL": "https://sentris-web.kumarbharath63.workers.dev",
    "DODO_ENV": "test_mode",
    "DODO_PRO_PRODUCT_ID": "pdt_0NqmoKiBKQyR2wXk8NhKM",
    // Beta only: free orgs may sync until this date (ISO). Empty or past = Pro required.
    "BETA_FREE_SYNC_UNTIL": "2026-11-30"
  },
  // Per Cloudflare location and approximate; period must be 10 or 60 seconds
  "ratelimits": [
    { "name": "INGEST_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "INGEST_KEY_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "AUTH_IP_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ]
}
