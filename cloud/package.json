{
  "name": "sentris-zk-cloud",
  "version": "0.2.0",
  "private": true,
  "description": "Cloudflare Worker + D1 Zero-Knowledge Telemetry & Dodo Payments MoR Backend for Sentris",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute sentris-zk-db --local --file=./schema.sql",
    "db:init:prod": "wrangler d1 execute sentris-zk-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "wrangler": "^3.83.0"
  }
}
